diff --git a/verification/formal/v7_scheduler_predicates.sv b/verification/formal/v7_scheduler_predicates.sv
new file mode 100644
--- /dev/null
+++ b/verification/formal/v7_scheduler_predicates.sv
@@ -0,0 +1,23 @@
+// Prove the production predicate tree for all candidate and age-mask inputs,
+// without assuming that age bits form a total order.
+module scheduler_predicates #(
+    parameter integer WIDTH = 12
+) (
+    input wire [WIDTH-1:0] candidates,
+    input wire [WIDTH-1:0] older,
+    input wire branch_occupied,
+    output wire ok
+);
+    wire none, one;
+    integer count;
+    zero_one_tree #(.WIDTH(WIDTH)) dut (
+        .bits(candidates & older), .none(none), .one(one)
+    );
+    always @* begin
+        count = 0;
+        for (integer k = 0; k < WIDTH; k = k + 1)
+            if (candidates[k] && older[k]) count = count + 1;
+    end
+    assign ok = (none == (count == 0)) && (one == (count == 1))
+        && ((branch_occupied ? none : one) == (count == (branch_occupied ? 0 : 1)));
+endmodule
diff --git a/verilog/common/zero_one_tree.sv b/verilog/common/zero_one_tree.sv
new file mode 100644
--- /dev/null
+++ b/verilog/common/zero_one_tree.sv
@@ -0,0 +1,30 @@
+// Balanced predicates for an arbitrary-width vector. Only the zero and one
+// cases are needed by the scheduler; a full population count adds carry depth.
+module zero_one_tree #(
+    parameter integer WIDTH = 1
+) (
+    input  wire [WIDTH-1:0] bits,
+    output wire none,
+    output wire one
+);
+    localparam integer LEAVES = 1 << $clog2(WIDTH);
+    wire [2*LEAVES-1:1] zeros, ones;
+    generate
+        for (genvar k = 0; k < LEAVES; k = k + 1) begin : leaves
+            if (k < WIDTH) begin : used
+                assign zeros[LEAVES+k] = !bits[k];
+                assign ones[LEAVES+k] = bits[k];
+            end else begin : padding
+                assign zeros[LEAVES+k] = 1'b1;
+                assign ones[LEAVES+k] = 1'b0;
+            end
+        end
+        for (genvar k = 1; k < LEAVES; k = k + 1) begin : branches
+            assign zeros[k] = zeros[2*k] && zeros[2*k+1];
+            assign ones[k] = (ones[2*k] && zeros[2*k+1])
+                          || (zeros[2*k] && ones[2*k+1]);
+        end
+    endgenerate
+    assign none = zeros[1];
+    assign one = ones[1];
+endmodule
